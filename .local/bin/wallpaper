#!/bin/sh

set -euo pipefail

readonly WALLPAPER_DIR="${XDG_DATA_HOME:-$HOME/.local/share/}/wallpapers"

set_wallpaper() {
    if ! pgrep -x awww-daemon >/dev/null 2>&1; then
        awww-daemon &
        disown
        sleep 0.5
    fi

    matugen image "$1" -m dark -t scheme-fidelity --prefer saturation
}

if [[ -n "${1-}" ]]; then
    if [[ "$1" == "random" ]]; then
        random=$(find "$WALLPAPER_DIR" -iregex '.*.\(jpg\|jpeg\|png\|gif\)' -type f -printf "%f\n" | shuf -n 1)
        set_wallpaper "$WALLPAPER_DIR/$random"
        chosen_wallpaper="$WALLPAPER_DIR/$random"
    elif [[ -e "$1" ]]; then
        set_wallpaper "$1"
        chosen_wallpaper="$1"
    else
        notify-send "Failed to set wallpaper:" "File does not exist"
        exit 1
    fi
else
    chosen_wallpaper=$(echo -e "Random\n$(ls -v "$WALLPAPER_DIR")" | wofi -d -L 20 -p "Choose a wallpaper: " || exit 1)

    if [[ "$chosen_wallpaper" == "Random" ]]; then
        chosen_wallpaper=$(find "$WALLPAPER_DIR" -iregex '.*.\(jpg\|jpeg\|png\|gif\)' -type f -printf "%f\n" | shuf -n 1)
        set_wallpaper "$WALLPAPER_DIR/$chosen_wallpaper"
    else
        set_wallpaper "$WALLPAPER_DIR/$chosen_wallpaper"
    fi
fi
