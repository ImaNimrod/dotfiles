#!/bin/sh

set -euo pipefail

readonly SCREENSHOT_DIR="${XDG_DATA_HOME:-$HOME/.local/share/}/screenshots"
readonly FILE="$SCREENSHOT_DIR/$(date +%F_%T).png"

choice=$(echo -e "Fullscreen\nSelected area\nSelected window" | wofi -d -L 3 -p "Screenshot:" || exit 1)
case $choice in
    "Fullscreen")
        grim -g "$(slurp -p)" - | tee "$FILE" | wl-copy
        ;;
    "Selected area")
        grim -g "$(slurp -d)" - | tee "$FILE" | wl-copy
        ;;
esac
