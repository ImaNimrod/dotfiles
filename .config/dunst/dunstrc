[global]
    monitor = 0
    follow = keyboard
    width = 400
    height = 350
    offset = 0x50
    padding = 2
    horizontal_padding = 2
    font = mononoki Nerd Font 18
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#6f00be"
    foreground = "#ffffff"
    timeout = 3

[urgency_normal]
    background = "#6f00be"
    foreground = "#ffffff"
    timeout = 5

[urgency_critical]
    background = "#fa00a7"
    foreground = "#ffffff"
    frame_color = "#ffffff"
    timeout = 10
